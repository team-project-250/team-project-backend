# Copy this file to .env and adjust the values for your machine.
# .env is git-ignored — never commit real secrets.

# Which settings module to load: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=dev-insecure-change-me

DEBUG=True

# PostgreSQL connection string.
# Matches the docker-compose service; change if you run Postgres yourself.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/easyrent

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production only (config.settings.production):
# ALLOWED_HOSTS=api.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# Reverse proxies in front of the app — rate limiting reads the client IP
# from X-Forwarded-For using this.
# NUM_PROXIES=1
# Uploaded media storage (S3-compatible). Leave unset to keep files on disk,
# which Render wipes on every deploy.
# AWS_STORAGE_BUCKET_NAME=easyrent-media
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.example.com
