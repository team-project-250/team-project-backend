# Copy this file to .env and adjust the values for your machine.
# .env is git-ignored — never commit real secrets.

# Which settings module to load: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=dev-insecure-change-me

DEBUG=True

# PostgreSQL connection string.
# Matches the docker-compose service; change if you run Postgres yourself.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/easyrent

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production only (config.settings.production):
# ALLOWED_HOSTS=api.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com
